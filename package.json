{
  "name": "@hiero-ledger/hiero-cli",
  "version": "1.3.0",
  "description": "CLI tool to manage and setup developer environments for Hiero-Ledger.",
  "main": "hiero-cli.js",
  "target": "esnext",
  "module": "esnext",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "hcli": "./dist/hiero-cli.js"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "npm run format && rimraf --glob 'dist/' && tsc && tsc-alias && npm run copy-contracts && chmod +x dist/hiero-cli.js",
    "build-test": "tsc && tsc -p tsconfig.test.json && npm run test ",
    "clean": "rm -rf dist/ && rm -rf coverage/ && rm -rf junit.xml && rm -rf junit-integration.xml",
    "copy-contracts": "copyfiles -u 1 \"examples/contracts/**/*.sol\" dist",
    "debug": "ts-node --inspect src/hiero-cli.ts",
    "dev": "ts-node src/hiero-cli.ts",
    "dev-build": "rm -rf dist/ && tsc && chmod +x dist/hiero-cli.js && npm run watch",
    "dev:watch": "nodemon --exec ts-node src/hiero-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hcli": "ts-node src/hiero-cli.ts",
    "install": "if [ \"$NPM_CI\" != 1 ]; then echo '\n\n=== Please use `npm run install:safe` ===\n\n' && exit 1; fi",
    "install:safe": "NPM_CI=1 npm ci",
    "lint": "npm run lint:eslint && npm run lint:md",
    "lint:eslint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:staged": "lint-staged && eslint . --quiet",
    "prepare": "husky || echo husky not installed - skipping git hooks setup",
    "single-test": "jest",
    "solo": "npm run solo:install && npm run solo:deploy && npm run solo:check",
    "solo:check": "bash scripts/solo/check.sh",
    "solo:deploy": "bash scripts/solo/deploy.sh",
    "solo:destroy": "bash scripts/solo/destroy.sh",
    "solo:down": "npm run solo:destroy",
    "solo:install": "bash scripts/solo/install.sh",
    "solo:up": "npm run solo:deploy && npm run solo:check",
    "start": "ts-node src/hiero-cli.ts",
    "test": "npm run test:unit",
    "test:all": "npm run typecheck && npm run build && npm run test:unit:run && npm run test:integration",
    "test:integration": "cross-env JEST_SUITE_NAME=\"Integration Tests\" JEST_JUNIT_OUTPUT_NAME=\"junit-integration.xml\" jest -c jest.integration.config.js --coverage --coverageDirectory=coverage/integration --detectOpenHandles",
    "test:unit": "npm run typecheck && cross-env JEST_SUITE_NAME=\"Unit Tests\" JEST_JUNIT_OUTPUT_NAME=\"junit.xml\" jest -c jest.unit.config.js --coverage --coverageDirectory=coverage/unit",
    "test:unit:run": "cross-env JEST_SUITE_NAME=\"Unit Tests\" JEST_JUNIT_OUTPUT_NAME=\"junit.xml\" jest -c jest.unit.config.js --coverage --coverageDirectory=coverage/unit",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "update-contributors": "node scripts/update-contributors.mjs",
    "watch": "tsc --watch"
  },
  "keywords": [
    "CLI",
    "DLT",
    "Hashgraph",
    "Hedera",
    "Hiero",
    "Hiero-Ledger"
  ],
  "author": "Michiel Mulders",
  "contributors": [
    "AgrimTawani",
    "Andrew Brandt",
    "fessmm",
    "Furkan",
    "Giuseppe Bertone",
    "Jessica G",
    "matevszm",
    "michal.myslinski",
    "michalrozekariane",
    "Mihail Mihov",
    "mmyslblocky",
    "Nathan Klick",
    "Pavel Borisov",
    "PavelSBorisov",
    "Roger Barker",
    "rozekmichal"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiero-ledger/hiero-cli.git"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@hiero-ledger/proto": "2.31.0",
    "@hiero-ledger/sdk": "2.89.1",
    "@openzeppelin/contracts": "5.6.1",
    "@x402/core": "2.28.0",
    "@x402/hedera": "2.28.0",
    "ansi-escapes": "7.3.0",
    "bignumber.js": "11.1.5",
    "commander": "15.0.0",
    "ethers": "6.17.0",
    "handlebars": "4.7.9",
    "jiti": "2.7.0",
    "solc": "0.8.37",
    "supports-hyperlinks": "4.6.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "dotenv": "18.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "nodemon": "3.1.14",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hiero-ledger/proto": "2.31.0",
    "protobufjs": "8.6.6",
    "tmp": "0.2.7"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}

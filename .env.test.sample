# Local Hiero Network (start your own running `npm run solo`)
OPERATOR_ID=0.0.2
OPERATOR_KEY=302e020100300506032b65700422042091132178e72057a1d7528025956fe39b0b847f200ab59b2fdd367017f3087137
NETWORK=localnet
# The localnet operator (0.0.2) uses an ED25519 key, which the CLI rejects unless
# the `ed25519_support` config option is enabled. The integration global setup
# restores it from this variable after wiping the test state.
ED25519_SUPPORT=true

# Local network endpoints used by `npm run test:all`.
# The same parameters as published on the host are:
#   consensus node (gRPC) localhost:35211
#   mirror node           http://localhost:38081
#   JSON-RPC relay        http://localhost:37546
#   explorer              http://localhost:38080
# The CLI appends `/api/v1` to the mirror node URL and `/localnet` to the
# explorer URL.

# If the tests run inside a container, the host-published ports are
# reached through host.docker.internal instead of localhost.
# CONSENSUS_NODE_ENDPOINT=host.docker.internal:35211
# MIRROR_NODE_URL=http://host.docker.internal:38081
# JSON_RPC_RELAY_URL=http://host.docker.internal:37546
# EXPLORER_URL=http://host.docker.internal:38080

# Hedera testnet
#OPERATOR_ID=0.0.XXXX
#OPERATOR_KEY=DER_PRIVATE_KEY
#NETWORK=testnet
